{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "../../scripts/node_modules/.bin/tsx --test --experimental-test-module-mocks src/lib/deriv.test.ts src/routes/deriv.test.ts",
    "capacity:demo": "../../scripts/node_modules/.bin/tsx scripts/deriv-demo-capacity.ts",
    "capacity:demo:smoke": "../../scripts/node_modules/.bin/tsx scripts/deriv-demo-capacity.ts --single-demo-smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/express": "^2.1.66",
    "@clerk/shared": "^4.31.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
