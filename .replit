modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
DERIV_APP_ID = "34khmki4wO4sOu08TgZZ5"
DERIV_CURRENCY = "USD"
DERIV_SYMBOL = "R_75"
MAX_TRADE_AMOUNT = "100"
