# Deriv application ID. This is not a secret, but keeping it configurable
# makes switching between environments less error-prone.
DERIV_APP_ID=34khmki4wO4sOu08TgZZ5

# Keep the PAT server-side. Never commit a real value or put it in frontend code.
DERIV_API_TOKEN=replace_with_your_deriv_pat
# Optional. If omitted, the server selects a demo account when available.
DERIV_ACCOUNT_ID=

# A separate key for this app's own API. Use a long random value.
# The dashboard asks for it and keeps it only in sessionStorage.
DASHBOARD_API_KEY=replace_with_a_long_random_dashboard_key

PORT=3000
DERIV_SYMBOL=R_75
DERIV_CURRENCY=USD
MAX_TRADE_AMOUNT=100
CORS_ORIGIN=http://localhost:3000

# Leave false until you have added and tested a strategy.
# The included bot loop is observation-only and never places trades.
ENABLE_BOT=false